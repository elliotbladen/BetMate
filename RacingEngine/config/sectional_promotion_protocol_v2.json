    "future_group_horse_cohort_required": true,
    "future_group_horse_horizons_days": [90, 180, 365],
    "future_group_horse_required_metrics": [
      "future_peak_rating_mae",
      "group_achievement_calibration",
      "precision",
      "recall",
      "false_discovery_rate",
      "median_lead_time_days"
    ],
    "future_group_horse_required_baselines": [
      "pre_race_official_rating",
      "class_only_v2",
      "naive_age_and_start_count"
    ],
    "market_or_ev_test_is_step_6_not_step_2": true
  }
}
