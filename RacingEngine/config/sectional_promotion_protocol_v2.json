{
  "version": "sectional-promotion-protocol-v2.0",
  "frozen_at": "2026-08-23",
  "training_cutoff": "2026-08-15",
  "rules": {
    "accepted_ratings_unchanged_until_full_pass": true,
    "coefficient_fitting_uses_pre_2025_only": true,
    "common_race_policy": "at least 60% prior-form coverage",
    "minimum_forward_ranking_races_per_jurisdiction": 100,
    "minimum_forward_ranking_races_per_distance_band": 50,
    "minimum_next_start_pairs_per_jurisdiction": 500,
    "ranking_log_loss_must_improve": ["overall", "NSW", "VIC", "sprint", "middle", "staying"],
    "next_start_mae_must_improve": ["overall", "NSW", "VIC", "sprint", "middle", "staying"],
    "paired_95_percent_upper_bound_must_be_below_zero": ["overall ranking", "overall next-start", "NSW ranking", "NSW next-start", "VIC ranking", "VIC next-start"],
    "live_forward_test_required": true,
    "expert_breakout_sanity_audit_required": true,
    "expert_sanity_bands_are_evaluation_only_not_training_labels": true,
    "natural_fling_2026_08_15_achieved_rating_acceptance_band": [100, 110],
